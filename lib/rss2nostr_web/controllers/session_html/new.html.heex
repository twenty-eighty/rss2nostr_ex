<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - RSS2Nostr</title>
    <link rel="stylesheet" href="/static/style.css" />
  </head>
  <body class="login-body">
    <main class="login-card">
      <h1>RSS2Nostr</h1>
      <p class="login-lead">Admin access requires a NIP-07 browser extension.</p>
      <%= if @configured? do %>
        <p id="login-status" class="help-text">Checking for a Nostr extension…</p>
        <p id="login-error" class="login-error" hidden></p>
        <button type="button" id="login-button" class="btn btn-primary">
          Login with Nostr
        </button>
        <p class="help-text">
          Extensions: Alby, nos2x, and others that provide
          <a href="https://nips.nostr.com/7" target="_blank" rel="noopener">window.nostr</a>.
        </p>
      <% else %>
        <p class="help-text">
          No admin keys are configured. Set <code>ADMIN_NOSTR_PUBKEYS</code> in
          <code>.env</code> to one or more npub or hex public keys, then restart the server.
        </p>
      <% end %>
    </main>
    <%= if @configured? do %>
      <script>
        (function () {
          const status = document.getElementById("login-status");
          const errorEl = document.getElementById("login-error");
          const button = document.getElementById("login-button");
          const waitMs = 8000;

          function showError(message) {
            errorEl.hidden = false;
            errorEl.textContent = message;
            console.error("[rss2nostr login]", message);
          }

          function hideError() {
            errorEl.hidden = true;
            errorEl.textContent = "";
          }

          function setStatus(message) {
            status.textContent = message;
          }

          function hasNostr() {
            try {
              return !!(window.nostr && typeof window.nostr.signEvent === "function");
            } catch (err) {
              return false;
            }
          }

          function waitForNostr(timeout) {
            if (hasNostr()) return Promise.resolve(window.nostr);
            setStatus("Waiting for a NIP-07 extension…");
            return new Promise(function (resolve, reject) {
              const started = Date.now();
              const timer = setInterval(function () {
                if (hasNostr()) {
                  clearInterval(timer);
                  resolve(window.nostr);
                } else if (Date.now() - started >= timeout) {
                  clearInterval(timer);
                  reject(new Error("No NIP-07 extension found. Allow this site in Alby/nos2x and reload."));
                }
              }, 200);
            });
          }

          function errorMessage(err) {
            if (!err) return "Login failed.";
            if (typeof err === "string") return err;
            if (err.message) return err.message;
            try { return JSON.stringify(err); } catch (_e) { return String(err); }
          }

          async function login() {
            hideError();
            button.disabled = true;
            setStatus("Waiting for extension…");
            console.info("[rss2nostr login] starting");

            try {
              const nostr = await waitForNostr(waitMs);
              setStatus("Requesting login challenge…");
              const challengeRes = await fetch("/auth/challenge", {
                credentials: "same-origin",
                headers: { "accept": "application/json" }
              });
              if (!challengeRes.ok) {
                throw new Error("Could not get a login challenge (HTTP " + challengeRes.status + ").");
              }
              const challenge = await challengeRes.json();
              console.info("[rss2nostr login] challenge received");

              const unsigned = {
                kind: challenge.kind,
                created_at: Math.floor(Date.now() / 1000),
                tags: [
                  ["u", challenge.url],
                  ["method", challenge.method],
                  ["challenge", challenge.challenge]
                ],
                content: challenge.content
              };

              setStatus("Approve the login event in your extension…");
              const signed = await nostr.signEvent(unsigned);
              if (!signed || !signed.sig) {
                throw new Error("Extension did not return a signed event.");
              }
              console.info("[rss2nostr login] event signed");

              setStatus("Verifying login…");
              const loginRes = await fetch("/auth/login", {
                method: "POST",
                credentials: "same-origin",
                headers: { "content-type": "application/json", "accept": "application/json" },
                body: JSON.stringify({ event: signed })
              });
              const body = await loginRes.json().catch(function () { return {}; });

              if (!loginRes.ok) {
                throw new Error(body.error || "Login failed (HTTP " + loginRes.status + ").");
              }

              const next = new URLSearchParams(window.location.search).get("next");
              window.location.href = (next && next.startsWith("/") && !next.startsWith("//")) ? next : "/";
            } catch (err) {
              showError(errorMessage(err));
              setStatus("Sign a login event with your NIP-07 extension to continue.");
              button.disabled = false;
            }
          }

          button.addEventListener("click", function (event) {
            event.preventDefault();
            login();
          });

          waitForNostr(waitMs).then(function () {
            setStatus("A Nostr extension was detected. Sign a login event to continue.");
          }).catch(function (err) {
            setStatus(err.message);
          });
        })();
      </script>
    <% end %>
  </body>
</html>
