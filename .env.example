# Copy to .env and adjust. OS environment variables override these values.
# ./bin/dev creates .env from this file if it is missing.

# Database (local PostgreSQL, not Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rss2nostr_dev

# Web server
PORT=4000
# Cookie signing for the admin session (24h). Generate with: openssl rand -base64 48
# If unset, a key is stored in .secret_key_base (mode 0600) so restarts keep the session.
# Also used to encrypt source signing keys (nsec) at rest — set this in production.
# SECRET_KEY_BASE=

# Admin UI: comma-separated npub or hex public keys allowed to log in via NIP-07
# ADMIN_NOSTR_PUBKEYS=npub1...

# MCP HTTP at /mcp. Prefer setting a bearer token. stdio (`mix rss2nostr.mcp`) does not use this.
# MCP_TOKEN=
# Allow unauthenticated loopback /mcp only for local dev (unsafe behind reverse proxies).
# MCP_ALLOW_LOOPBACK=true
# Optional browser CORS origins (comma-separated). Empty disables CORS.
# MCP_CORS_ORIGINS=https://example.com
# Optional Host allow-list (comma-separated), or "any".
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Production TLS / LiveView origin
# FORCE_SSL=true
# SECURE_COOKIES=true
# PHX_HOST=rss2nostr.example.com
# URL_SCHEME=https

# Nostr publishing (required to export)
# NOSTR_NSEC=nsec1...
# Draft relays (NIP-37 wraps for the Pareto client). Falls back to the test list if unset.
NOSTR_RELAYS_DRAFT=
# Test relays (fallback when the draft list is empty). NOSTR_RELAYS is an alias for this list.
NOSTR_RELAYS_TEST=wss://nos.lol,wss://relay.damus.io
# Public relays (article and video sources; also the staging-DM fallback)
NOSTR_RELAYS_PUBLIC=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
# Extra relays always used when sending NIP-17 staging DMs (in addition to NIP-05 / public)
NOSTR_RELAYS_INBOX=
# Default audience when a source is missing: test or public
# NOSTR_RELAY_AUDIENCE=test
# Pause between articles when publishing several (Damus rate-limits bursts).
# NOSTR_PUBLISH_GAP_MS=10000

# Optional
# NOSTR_PRIVATE_KEY=
# NOSTR_PUBLIC_KEY=
# npub or hex pubkey whose kind-3 contact list marks followed feed authors (refreshed hourly)
# NOSTR_AUTHORS_FOLLOW_LIST_PUBKEY=npub1...
# Blossom server (BUD-02). Images are PUT to {endpoint}/upload.
# NOSTR_UPLOAD_ENDPOINT=https://blossom.primal.net
# NOSTR_BUNKER_CONNECTION=bunker://...
# DEFAULT_LANGUAGE=de
# IMPORT_INTERVAL_MINUTES=60
# Start import/process/export/cleanup timers when the server boots (default: false)
# SCHEDULER_AUTO_START=true

# Production
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
# POOL_SIZE=10
#
# Docker / Coolify (set in the container environment; do not rely on .env in the image)
# PORT=4000
# SKIP_MIGRATIONS=true   # optional: skip auto-migrate on container start
